PORT=3001
# Quando usar docker-compose, use estes valores:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=toolmaster
DB_PASSWORD=toolmaster_pass
DB_NAME=toolmaster
JWT_SECRET=segredo_local

# Ajuste estes valores conforme seu ambiente local. Copie para `.env` antes de rodar.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=database_name
DB_PORT=3306
JWT_SECRET=segredo_super_forte
